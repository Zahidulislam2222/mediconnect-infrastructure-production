# Server-side runtime configuration. This file contains safe placeholders only.
# Actual values belong in the gitignored project CREDENTIALS.md and approved runtime secret stores.

ADMIN_EMAIL=admin@example.invalid
ALLOWED_ORIGIN=https://app.example.invalid
ALLOWED_ORIGINS=https://app.example.invalid
# Additional mobile/development origins are opt-in, for example ["http://localhost:5173"].
CORS_ADDITIONAL_ORIGINS_JSON=[]
CORS_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,HEAD,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,Prefer,If-Match,x-user-region,Idempotency-Key
HTTP_HSTS_MAX_AGE_SECONDS=31536000
HTTP_CSP_CONNECT_ORIGINS_JSON=[]
HTTP_CSP_SCRIPT_ORIGINS_JSON=[]
HTTP_CSP_IMAGE_ORIGINS_JSON=[]
API_PUBLIC_URL=https://api.example.invalid
AUDIT_TARGET_ID=replace-me
AWS_REGION=us-east-1
PRIVACY_US_REGION=us-east-1
PRIVACY_EU_REGION=eu-central-1
PRIVACY_MAX_PAGES=1000
PRIVACY_BATCH_ATTEMPTS=5
PRIVACY_RETRY_DELAY_MS=100
PRIVACY_LEASE_SECONDS=3600
PRIVACY_POLICY_VERSION=review-required
# Enable only after approving the regional retention/erasure policy; requests remain durable while disabled.
PRIVACY_EXECUTION_ENABLED=false
PRIVACY_BQ_ENDPOINT=https://bigquery.googleapis.com/bigquery/v2
PRIVACY_BQ_LOCATION_US=US
PRIVACY_BQ_LOCATION_EU=EU
PRIVACY_BQ_ANALYTICS_US=mediconnect_analytics
PRIVACY_BQ_ANALYTICS_EU=mediconnect_analytics_eu
