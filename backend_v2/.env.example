PRIVACY_BQ_IOT_EU=iot_eu
IOT_ANALYTICS_TABLE=vitals_raw
PRIVACY_BQ_MAX_POLLS=10
PRIVACY_BQ_POLL_DELAY_MS=500
PRIVACY_BQ_TIMEOUT_MS=10000
# AWS SDK credential-chain control; disable EC2 metadata discovery in local/test environments.
